<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SPT_AKI_Profile_Editor.ModHelper</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.0.8</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SemanticVersioning">
      <HintPath>E:\SPT\SPT_Runtime\SemanticVersioning.dll</HintPath>
    </Reference>
    <Reference Include="SPTarkov.Common">
      <HintPath>E:\SPT\SPT_Runtime\SPTarkov.Common.dll</HintPath>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>E:\SPT\SPT_Runtime\SPTarkov.DI.dll</HintPath>
    </Reference>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>E:\SPT\SPT_Runtime\SPTarkov.Server.Core.dll</HintPath>
    </Reference>
    <Reference Include="Spectre.Console.Ansi">
      <HintPath>E:\SPT\SPT_Runtime\Spectre.Console.Ansi.dll</HintPath>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Configuration>Release</Configuration>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <Target Name="CreateVersionFile" AfterTargets="Build">
    <WriteLinesToFile
      File="$(OutputPath)version"
      Lines="$(Version)"
      Overwrite="true"
      Encoding="UTF-8" />
    <Message Text="Version file created: $(OutputPath)version with version $(Version)" Importance="high" />
  </Target>

</Project>
