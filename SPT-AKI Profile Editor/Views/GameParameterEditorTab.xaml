<UserControl
    x:Class="SPT_AKI_Profile_Editor.Views.GameParameterEditorTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:SPT_AKI_Profile_Editor.Views"
    d:DataContext="{d:DesignInstance Type=views:GameParameterEditorTabViewModel}"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,10"
            FontSize="16"
            FontWeight="Bold"
            Text="{Binding AppLocalization.Translations[tab_game_parameter_editor_title], FallbackValue=tab_game_parameter_editor_title}" />

        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,0,10,5"
            VerticalAlignment="Center"
            Text="BossChance" />

        <TextBox
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,0,0,5"
            Text="{Binding BossChanceText}" />

        <Button
            Grid.Row="2"
            Grid.Column="1"
            Width="160"
            HorizontalAlignment="Left"
            Command="{Binding ApplyBossChanceCommand}"
            Content="Apply" />
    </Grid>
</UserControl>
